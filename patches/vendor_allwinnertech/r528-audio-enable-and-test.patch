diff --git a/Make.defs b/Make.defs
index 6493185f..9f895961 100644
--- a/Make.defs
+++ b/Make.defs
@@ -13,8 +13,9 @@ CUR_FOLDER := $(notdir $(patsubst %/,%,$(dir $(lastword $(MAKEFILE_LIST)))))
 AW_VENDOR_DIR := $(APPDIR)/vendor/allwinnertech
 AW_CHIP_DIR   := $(AW_VENDOR_DIR)/chips/r528
 
-# Only include if this vendor matches the board config
-ifeq ($(findstring $(CUR_FOLDER),$(CONFIG_ARCH_BOARD_CUSTOM_DIR)), $(CUR_FOLDER))
+# Include for Allwinner custom boards and for the R528 contest board, whose
+# board directory lives in the contest repository rather than under vendor.
+ifneq ($(filter $(CUR_FOLDER),$(CONFIG_ARCH_BOARD_CUSTOM_DIR))$(CONFIG_ARCH_CHIP_R528),)
 
 # HAL test applications (optional)
 include $(wildcard $(AW_CHIP_DIR)/drivers/rtos-hal/hal/test/Make.defs)
@@ -25,4 +26,4 @@ include $(wildcard $(AW_CHIP_DIR)/components/Make.defs)
 # Vendor applications
 include $(AW_VENDOR_DIR)/apps/Make.defs
 
-endif # CUR_FOLDER check
+endif # Allwinner board check
