+static void sunxi_codec_set_spk(struct snd_codec *codec, int enable)
+{
+	struct sunxi_codec_info *sunxi_codec = codec->private_data;
+	struct sunxi_codec_param *param = &sunxi_codec->param;
+	gpio_direction_t direction = GPIO_DIRECTION_INPUT;
+	gpio_data_t data = GPIO_DATA_LOW;
+	gpio_data_t target = enable ? param->pa_level : !param->pa_level;
+	int direction_ret;
+	int data_ret;
+	int direction_get_ret;
+	int data_get_ret;
+
+	direction_ret = hal_gpio_set_direction(param->gpio_spk,
+						 GPIO_MUXSEL_OUT);
+	data_ret = hal_gpio_set_data(param->gpio_spk, target);
+	direction_get_ret = hal_gpio_get_direction(param->gpio_spk, &direction);
+	data_get_ret = hal_gpio_get_data(param->gpio_spk, &data);
+
+	syslog(LOG_INFO,
+		"codec amp enable=%d gpio=%d target=%d dir=%d data=%d "
+		"ret=%d/%d/%d/%d\n",
+		enable, param->gpio_spk, target, direction, data,
+		direction_ret, data_ret, direction_get_ret, data_get_ret);
+
+	if (enable)
+		hal_msleep(param->pa_msleep_time);
+}
