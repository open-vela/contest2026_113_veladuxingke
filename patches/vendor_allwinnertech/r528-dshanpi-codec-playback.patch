+static void sunxi_codec_ramp_update_bits(struct snd_codec *codec,
+					 uint32_t mask, uint32_t value)
+{
+	uint32_t old;
+	uint32_t new;
+
+	if (mask & RAMP_W1C_MASK) {
+		snd_err("ramp update contains W1C bits: mask=0x%08x\n",
+			(unsigned int)mask);
+		return;
+	}
+
+	old = snd_codec_read(codec, SUNXI_RAMP_ANA_CTL);
+	new = ((old & ~mask) | (value & mask)) & ~RAMP_W1C_MASK;
+	if ((old & mask) != (new & mask))
+		snd_codec_write(codec, SUNXI_RAMP_ANA_CTL, new);
+}
+
+static void sunxi_codec_ramp_ack(struct snd_codec *codec, uint32_t status)
+{
+	uint32_t value;
+
+	status &= RAMP_W1C_MASK;
+	if (!status)
+		return;
+
+	value = snd_codec_read(codec, SUNXI_RAMP_ANA_CTL);
+	value = (value & ~RAMP_W1C_MASK) | status;
+	snd_codec_write(codec, SUNXI_RAMP_ANA_CTL, value);
+}
+
+static void sunxi_codec_ramp_wait_and_ack(struct snd_codec *codec,
+					  uint32_t status)
+{
+	int retries;
+
+	for (retries = 0; retries < 120; retries++) {
+		if (snd_codec_read(codec, SUNXI_RAMP_ANA_CTL) & status) {
+			sunxi_codec_ramp_ack(codec, status);
+			return;
+		}
+
+		hal_msleep(1);
+	}
+
+	snd_err("ramp completion timeout: status=0x%08x ramp=0x%08x\n",
+		(unsigned int)status,
+		(unsigned int)snd_codec_read(codec, SUNXI_RAMP_ANA_CTL));
+}
