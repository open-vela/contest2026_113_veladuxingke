+/* Parse the small, explicit Chinese edit forms used by the desktop routine
+ * workflow.  Keeping this path deterministic prevents a model from choosing
+ * read_file for /data/routine/status.json (that tool is intentionally scoped
+ * to /data/agent/).  More ambiguous requests continue through the LLM. */
+static bool routine_parse_time(const char *text, int *hour, int *minute)
+{
+    const char *p;
+
+    if (!text || !hour || !minute)
+        return false;
+
+    for (p = text; *p; p++) {
+        const char *q;
+        int h = 0;
+        int m = 0;
+        int digits = 0;
+
+        if (*p < '0' || *p > '9')
+            continue;
+
+        q = p;
+        while (*q >= '0' && *q <= '9' && digits < 3) {
+            h = h * 10 + (*q - '0');
+            q++;
+            digits++;
+        }
+        if (digits == 0 || h > 23)
+            continue;
+
+        while (*q == ' ' || *q == '\t')
+            q++;
+
+        if (*q == ':') {
+            q++;
+            while (*q == ' ' || *q == '\t')
+                q++;
+            if (*q < '0' || *q > '9')
+                continue;
+            m = 0;
+            digits = 0;
+            while (*q >= '0' && *q <= '9' && digits < 2) {
+                m = m * 10 + (*q - '0');
+                q++;
+                digits++;
+            }
+            if (digits == 0 || m > 59)
+                continue;
+        } else if (strncmp(q, "：", strlen("：")) == 0) {
+            q += strlen("：");
+            while (*q == ' ' || *q == '\t')
+                q++;
+            if (*q < '0' || *q > '9')
+                continue;
+            m = 0;
+            digits = 0;
+            while (*q >= '0' && *q <= '9' && digits < 2) {
+                m = m * 10 + (*q - '0');
+                q++;
+                digits++;
+            }
+            if (digits == 0 || m > 59)
+                continue;
+        } else if (strncmp(q, "点", strlen("点")) == 0) {
+            q += strlen("点");
+            while (*q == ' ' || *q == '\t')
+                q++;
+            if (strncmp(q, "半", strlen("半")) == 0) {
+                m = 30;
+            } else if (*q >= '0' && *q <= '9') {
+                m = 0;
+                digits = 0;
+                while (*q >= '0' && *q <= '9' && digits < 2) {
+                    m = m * 10 + (*q - '0');
+                    q++;
+                    digits++;
+                }
+                if (digits == 0 || m > 59)
+                    continue;
+            } else {
+                m = 0;
+            }
+        } else {
+            continue;
+        }
+
+        *hour = h;
+        *minute = m;
+        return true;
+    }
+
+    return false;
+}
+
+/* Return 1 when a replacement text was found, 0 when the request only
+ * changes time, and -1 when a text marker was malformed or too long. */
+static int routine_extract_text(const char *input, char *text, size_t text_size)
+{
+    static const char *markers[] = {
+        "事项改成", "事项改为", "内容改成", "内容改为",
+        "提醒改成", "提醒改为", "改成", "改为", NULL
+    };
+    const char *found = NULL;
+    size_t marker_len = 0;
+
+    if (!input || !text || text_size < 2)
+        return -1;
+
+    for (int i = 0; markers[i]; i++) {
+        const char *candidate = strstr(input, markers[i]);
+        const char *value;
+        if (candidate && (!found || candidate < found)) {
+            value = candidate + strlen(markers[i]);
+            while (*value == ' ' || *value == '\t' || *value == ':' )
+                value++;
+            /* In "喝水改成15:30", 改成 introduces the time.  Leave it
+             * available to routine_parse_time instead of treating it as the
+             * replacement text.  Explicit markers such as 事项改成 are
+             * always text markers, even when the text begins with a digit. */
+            if ((strcmp(markers[i], "改成") == 0 ||
+                 strcmp(markers[i], "改为") == 0) &&
+                *value >= '0' && *value <= '9')
+                continue;
+            found = candidate;
+            marker_len = strlen(markers[i]);
+        }
+    }
+    if (!found)
+        return 0;
+
+    const char *start = found + marker_len;
+    while (*start == ' ' || *start == '\t' || *start == ':' ||
+           *start == '"' || *start == '\'')
+        start++;
+    if (strncmp(start, "：", strlen("：")) == 0)
+        start += strlen("：");
+    if (strncmp(start, "“", strlen("“")) == 0)
+        start += strlen("“");
+
+    const char *end = start;
+    while (*end) {
+        if (*end == '\n' || *end == '\r' || *end == ',' ||
+            *end == '.' || *end == '!' || *end == '?' ||
+            *end == ';' || *end == '"' || *end == '\'' ||
+            strncmp(end, "，", strlen("，")) == 0 ||
+            strncmp(end, "。", strlen("。")) == 0 ||
+            strncmp(end, "！", strlen("！")) == 0 ||
+            strncmp(end, "？", strlen("？")) == 0 ||
+            strncmp(end, "；", strlen("；")) == 0 ||
+            strncmp(end, "”", strlen("”")) == 0) {
+            break;
+        }
+        end++;
+    }
+    while (end > start && (end[-1] == ' ' || end[-1] == '\t'))
+        end--;
+
+    size_t length = (size_t)(end - start);
+    if (length == 0 || length >= text_size)
+        return -1;
+    memcpy(text, start, length);
+    text[length] = '\0';
+    return 1;
+}
+
+static cJSON *routine_load_status(void)
+{
+    static const char *shell_input =
+        "{\"command\":\"cat /data/routine/status.json\"}";
+    char shell_result[4096];
+    cJSON *wrapper;
+    cJSON *status = NULL;
+    const char *raw;
+
+    memset(shell_result, 0, sizeof(shell_result));
+    if (tool_registry_execute("run_shell", shell_input,
+                              shell_result, sizeof(shell_result)) != OK)
+        return NULL;
+
+    wrapper = cJSON_Parse(shell_result);
+    if (!wrapper)
+        return NULL;
+    raw = cJSON_GetStringValue(cJSON_GetObjectItem(wrapper, "output"));
+    if (raw)
+        status = cJSON_Parse(raw);
+    cJSON_Delete(wrapper);
+    return status;
+}
+
+static cJSON *routine_find_status_slot(cJSON *status, int schedule_id)
+{
+    cJSON *schedule;
+    cJSON *item;
+
+    if (!status)
+        return NULL;
+    schedule = cJSON_GetObjectItemCaseSensitive(status, "schedule");
+    if (!cJSON_IsArray(schedule))
+        return NULL;
+
+    cJSON_ArrayForEach(item, schedule) {
+        cJSON *id = cJSON_GetObjectItemCaseSensitive(item, "id");
+        if (cJSON_IsNumber(id) && id->valueint == schedule_id)
+            return item;
+    }
+    return NULL;
+}
+
+static char *handle_routine_edit_fast_path(const char *input)
+{
+    static const char *edit_keywords[] = {
+        "改", "调整", "设置", "修改", "换成", "change", NULL
+    };
+    const char *slot_name = NULL;
+    int schedule_id = -1;
+    int hour = -1;
+    int minute = -1;
+    int text_state;
+    char new_text[128];
+    char old_text[128];
+    cJSON *status = NULL;
+    cJSON *slot = NULL;
+    cJSON *hour_item;
+    cJSON *minute_item;
+    cJSON *text_item;
+    cJSON *update = NULL;
+    char *update_json = NULL;
+    char tool_output[1024];
+    char *reply = NULL;
+
+    if (!input || !contains_any(input, edit_keywords))
+        return NULL;
+
+    if (strstr(input, "喝水")) {
+        slot_name = "喝水";
+        schedule_id = 0;
+    } else if (strstr(input, "专注")) {
+        slot_name = "专注";
+        schedule_id = 1;
+    } else if (strstr(input, "通风")) {
+        slot_name = "通风";
+        schedule_id = 2;
+    } else {
+        return NULL;
+    }
+
+    text_state = routine_extract_text(input, new_text, sizeof(new_text));
+    if (text_state < 0)
+        return strdup("日程事项文本为空或过长，未作修改。");
+
+    status = routine_load_status();
+    slot = routine_find_status_slot(status, schedule_id);
+    text_item = slot ? cJSON_GetObjectItemCaseSensitive(slot, "text") : NULL;
+    hour_item = slot ? cJSON_GetObjectItemCaseSensitive(slot, "hour") : NULL;
+    minute_item = slot ? cJSON_GetObjectItemCaseSensitive(slot, "minute") : NULL;
+    if (!slot || !cJSON_IsString(text_item) || !text_item->valuestring ||
+        !cJSON_IsNumber(hour_item) || !cJSON_IsNumber(minute_item)) {
+        cJSON_Delete(status);
+        return strdup("无法读取当前固定日程，未作修改。");
+    }
+
+    strlcpy(old_text, text_item->valuestring, sizeof(old_text));
+    hour = hour_item->valueint;
+    minute = minute_item->valueint;
+    if (routine_parse_time(input, &hour, &minute) == false &&
+        text_state == 0) {
+        cJSON_Delete(status);
+        return NULL;
+    }
+    if (text_state == 0)
+        strlcpy(new_text, old_text, sizeof(new_text));
+
+    update = cJSON_CreateObject();
+    if (update == NULL ||
+        !cJSON_AddNumberToObject(update, "schedule_id", schedule_id) ||
+        !cJSON_AddNumberToObject(update, "hour", hour) ||
+        !cJSON_AddNumberToObject(update, "minute", minute) ||
+        !cJSON_AddStringToObject(update, "text", new_text) ||
+        !cJSON_AddStringToObject(update, "expected_text", old_text)) {
+        cJSON_Delete(update);
+        cJSON_Delete(status);
+        return strdup("无法准备日程修改，未作修改。");
+    }
+    update_json = cJSON_PrintUnformatted(update);
+    cJSON_Delete(update);
+    cJSON_Delete(status);
+    if (!update_json)
+        return strdup("无法准备日程修改，未作修改。");
+
+    memset(tool_output, 0, sizeof(tool_output));
+    int rc = tool_registry_execute("routine_schedule_update", update_json,
+                                   tool_output, sizeof(tool_output));
+    free(update_json);
+
+    cJSON *result = cJSON_Parse(tool_output);
+    cJSON *ok = result ? cJSON_GetObjectItem(result, "ok") : NULL;
+    if (rc == OK && cJSON_IsTrue(ok)) {
+        reply = calloc(1, 512);
+        if (reply) {
+            snprintf(reply, 512, "已将每天%s日程改为 %02d:%02d，事项为“%s”。",
+                     slot_name, hour, minute, new_text);
+        }
+    } else {
+        const char *error = result
+            ? cJSON_GetStringValue(cJSON_GetObjectItem(result, "error"))
+            : NULL;
+        reply = calloc(1, 512);
+        if (reply) {
+            snprintf(reply, 512, "日程修改失败，未作修改%s%s。",
+                     error ? ": " : "", error ? error : "");
+        }
+    }
+    cJSON_Delete(result);
+    if (reply) {
+        s_fast_path_count++;
+        syslog(LOG_INFO,
+               "[%s] NL fast path: routine_schedule_update (fast=%d llm=%d)\n",
+               TAG, s_fast_path_count, s_llm_path_count);
+    }
+    return reply;
+}
