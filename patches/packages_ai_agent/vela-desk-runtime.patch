+/* Keep caching deliberately conservative. Greetings and thanks can be
+ * reused; confirmations such as "ok" or "yes" depend on the previous turn
+ * and must be evaluated again by the LLM and local tools. */
+bool llm_cache_prompt_is_safe(const char* prompt, size_t prompt_len)
+{
+    static const char* const safe_prompts[] = {
+        "hello", "hi", "hey", "thanks", "thank you",
+        "你好", "嗨", "谢谢", "再见", NULL
+    };
+    char normalized[LLM_CACHE_KEY_LEN + 1];
+    size_t start = 0;
+    size_t end = prompt_len;
+    size_t len;
+
+    if (!prompt || prompt_len == 0) {
+        return false;
+    }
+
+    while (start < end && (prompt[start] == ' ' || prompt[start] == '\t'
+        || prompt[start] == '\r' || prompt[start] == '\n')) {
+        start++;
+    }
+    while (end > start && (prompt[end - 1] == ' ' || prompt[end - 1] == '\t'
+        || prompt[end - 1] == '\r' || prompt[end - 1] == '\n')) {
+        end--;
+    }
+
+    len = end - start;
+    if (len == 0 || len > LLM_CACHE_KEY_LEN) {
+        return false;
+    }
+
+    memcpy(normalized, prompt + start, len);
+    normalized[len] = '\0';
+
+    for (int i = 0; safe_prompts[i] != NULL; i++) {
+        if (strcasecmp(normalized, safe_prompts[i]) == 0) {
+            return true;
+        }
+    }
+    return false;
+}
