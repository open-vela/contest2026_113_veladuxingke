+/* Queue a chat message after the wire format has been normalized.  The
+ * WebSocket client may identify a conversation in the JSON envelope; plain
+ * text and JSON-string frames use the connection's default chat_id. */
+static void ws_dispatch_chat(int fd, char* chat_id, const char* content,
+    const char* requested_chat_id)
+{
+    if (!content || !content[0])
+        return;
+
+    pthread_mutex_lock(&s_clients_mtx);
+    ws_client_t* client = find_by_fd_locked(fd);
+    if (client) {
+        if (requested_chat_id && requested_chat_id[0]) {
+            strncpy(client->chat_id, requested_chat_id,
+                sizeof(client->chat_id) - 1);
+            client->chat_id[sizeof(client->chat_id) - 1] = '\0';
+        }
+        strncpy(chat_id, client->chat_id, 31);
+        chat_id[31] = '\0';
+    }
+    pthread_mutex_unlock(&s_clients_mtx);
+
+    syslog(LOG_INFO, "[%s] WS msg from %s: %.40s\n", TAG, chat_id, content);
+
+    agent_msg_t msg = { 0 };
+    strncpy(msg.channel, AGENT_CHAN_WEBSOCKET, sizeof(msg.channel) - 1);
+    strncpy(msg.chat_id, chat_id, sizeof(msg.chat_id) - 1);
+    msg.content = strdup(content);
+    if (!msg.content)
+        return;
+
+    if (message_bus_push_inbound(&msg) != OK)
+        free(msg.content);
+}
