-    switch (s) {
-    case MEDIA_STATE_IDLE:
-        return "IDLE";
-    case MEDIA_STATE_PREPARED:
-        return "PREPARED";
-    case MEDIA_STATE_PLAYING:
-        return "PLAYING";
-    case MEDIA_STATE_PAUSED:
-        return "PAUSED";
-    case MEDIA_STATE_ERROR:
