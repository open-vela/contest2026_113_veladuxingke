# Reproducible source repository: keep generated build output out of commits.
*.o
*.a
*.elf
*.hex
*.depend
.built
Make.dep
*.map

# Host-side Python caches and local assistant state.
__pycache__/
*.py[cod]
.claude/
.mimocode/

