board/r528s3-dshanpi/src/etctmp
board/r528s3-dshanpi/src/etctmp.c

# Keep the checked-in Wi-Fi factory map available to reviewers/build scripts.
!board/r528s3-dshanpi/src/etc/wifi_factest/rtl8733bs_wifi.map
